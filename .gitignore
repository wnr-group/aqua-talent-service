# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log

# Build directory (if using TypeScript or a build step)
dist/
build/

# TypeScript build output co-located with .ts sources.
# src/lib is TS-only (no hand-written .js lives there), so this scoped
# pattern is safe - it won't touch the legacy CommonJS controllers/services.
src/lib/**/*.js
src/lib/**/*.js.map
src/lib/**/*.d.ts
src/lib/**/*.d.ts.map

# Same for the Supabase migration scripts (TS-only folder).
scripts/supabase-migration/**/*.js
scripts/supabase-migration/**/*.js.map

# Mongo backups contain real user data - never commit them.
backups/

# Debugging
.vscode/
.idea/

# Speckit / Feature Specs
specs/
.specify/

# Claude Code
.claude/