# Build directory (if using TypeScript or a build step)
dist/
build/

# TypeScript build output co-located with .ts sources (tsconfig.json has no
# outDir - compiled .js lands right next to its .ts so require() from the
# remaining plain CommonJS files keeps resolving). sourceMap is off, but the
# .js.map patterns stay in case it's ever re-enabled locally.
#
# Folders that are TS-only (no hand-written .js survives there) can be
# ignored wholesale. Folders with a genuine mix (some files converted, some
# still hand-written CommonJS) are listed file-by-file so the real sources
# never get hidden by accident.

# TS-only folders
src/lib/**/*.js
src/lib/**/*.js.map
src/lib/**/*.d.ts
src/lib/**/*.d.ts.map
scripts/supabase-migration/**/*.js
scripts/supabase-migration/**/*.js.map
src/config/*.js
src/config/*.js.map
src/constants/*.js
src/constants/*.js.map
src/middleware/*.js
src/middleware/*.js.map
scripts/*.js
scripts/*.js.map

# Mixed folders - only the files with a .ts source are compiled output.
