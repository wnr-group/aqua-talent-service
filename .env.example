# Server Configuration
PORT=3001

# MongoDB Configuration
# Only used by the one-time migration/backup tooling in
# scripts/supabase-migration/ - the app itself runs on Supabase (below).
MONGODB_URI=mongodb://localhost:27017/aqua-talent

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Configuration
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_FROM_EMAIL=Your App <noreply@yourdomain.com>
EMAIL_ENABLED=true

# File Storage - Supabase Storage
# Uses the native Supabase Storage API via SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# below - no separate credentials needed. Buckets (company-logos,
# student-resumes, student-videos) are created by
# supabase/migrations/20260922000001_media_storage_bucket.sql

# Password Reset Configuration
ADMIN_EMAIL=admin@yourdomain.com
FRONTEND_URL=http://localhost:3000

# Razorpay Payment Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Supabase Configuration (Mongo -> Postgres migration)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key only - never expose this to the frontend/browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

